---
import { siteConfig } from '../config/site';
---

<footer class="site-footer">
	<div class="shell footer-inner">
		<div class="footer-brand">
			<h3>🌿 {siteConfig.title}</h3>
			<p>A nurturing space for students to grow their knowledge and share their learning journey with the world.</p>
		</div>
		<div class="footer-links">
			<h4>Quick Links</h4>
			<ul>
				<li><a href="/">Home</a></li>
				<li><a href="/students/">Students</a></li>
				<li><a href="/docs/">Docs</a></li>
				<li><a href="/rss.xml">RSS Feed</a></li>
			</ul>
		</div>
		<div class="footer-links">
			<h4>Resources</h4>
			<ul>
				<li><a href="https://github.com" target="_blank" rel="noopener">GitHub</a></li>
				<li><a href="/docs/student-blog-setup">Getting Started</a></li>
				<li><a href="/docs/student-slug-policy">Slug Policy</a></li>
			</ul>
		</div>
	</div>
	<div class="footer-bottom">
		<p>🌱 Cultivated with care • {siteConfig.title} {new Date().getFullYear()}</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--stone);
		color: var(--paper);
		padding: 4rem 2rem 2rem;
		border-radius: 50px 50px 0 0;
		margin-top: 4rem;
	}

	.shell {
		max-width: 1100px;
		margin: 0 auto;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 3rem;
	}

	.footer-brand h3 {
		font-family: var(--display-font);
		font-size: 1.8rem;
		margin: 0 0 1rem 0;
	}

	.footer-brand p {
		margin: 0;
		opacity: 0.8;
		line-height: 1.7;
		max-width: 300px;
	}

	.footer-links h4 {
		font-family: var(--display-font);
		font-size: 1.2rem;
		margin: 0 0 1.5rem 0;
	}

	.footer-links ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-links li {
		margin-bottom: 0.75rem;
	}

	.footer-links a {
		color: var(--paper);
		opacity: 0.8;
		text-decoration: none;
		transition: opacity 0.3s ease;
	}

	.footer-links a:hover {
		opacity: 1;
	}

	.footer-bottom {
		max-width: 1100px;
		margin: 3rem auto 0;
		padding-top: 2rem;
		border-top: 1px solid rgba(245, 241, 232, 0.2);
		text-align: center;
		opacity: 0.6;
		font-size: 0.9rem;
	}

	@media (max-width: 720px) {
		.site-footer {
			padding: 3rem 1.5rem 2rem;
		}

		.footer-inner {
			gap: 2rem;
		}
	}
</style>
