---
import { formatDate } from '../lib/format';

interface Props {
	publishDate: Date;
	updatedDate?: Date;
	tags?: string[];
	studentLabel?: string;
	studentUrl?: string;
}

const { publishDate, updatedDate, tags = [], studentLabel, studentUrl } = Astro.props;
---

<div class="meta-row">
	<span class="meta-item">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
			<line x1="16" y1="2" x2="16" y2="6"></line>
			<line x1="8" y1="2" x2="8" y2="6"></line>
			<line x1="3" y1="10" x2="21" y2="10"></line>
		</svg>
		{formatDate(publishDate, 'compact')}
	</span>
	{updatedDate && (
		<span class="meta-item">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<polyline points="23 4 23 10 17 10"></polyline>
				<path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
			</svg>
			Updated {formatDate(updatedDate, 'compact')}
		</span>
	)}
	{studentLabel && (
		<span class="meta-item">
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
				<circle cx="12" cy="7" r="4"></circle>
			</svg>
			{studentUrl ? <a href={studentUrl}>{studentLabel}</a> : studentLabel}
		</span>
	)}
	{tags.map((tag) => (
		<span class="meta-tag">{tag}</span>
	))}
</div>

<style>
	.meta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
		color: var(--text-light);
		font-size: 0.85rem;
	}

	.meta-item {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.meta-item a {
		color: var(--stone);
		text-decoration: none;
		font-weight: 500;
	}

	.meta-item a:hover {
		text-decoration: underline;
	}

	.meta-tag {
		background: rgba(156, 175, 136, 0.2);
		padding: 0.2rem 0.6rem;
		border-radius: 15px;
		font-size: 0.75rem;
	}
</style>
