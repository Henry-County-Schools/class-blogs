---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/format';
import { getPostSlug, getPostUrl, getPublishedStudentBySlug, getStudentSlugFromPost, getStudentUrl, getStudentAccent } from '../lib/content';

interface Props {
	items: CollectionEntry<'posts'>[];
	showStudent?: boolean;
	emptyMessage?: string;
}

const { items, showStudent = false, emptyMessage = 'No posts available yet.' } = Astro.props;

const postCards = await Promise.all(
	items.map(async (post) => {
		const studentSlug = getStudentSlugFromPost(post);
		const student = showStudent ? await getPublishedStudentBySlug(studentSlug) : undefined;
		const accent = student ? getStudentAccent(student) : '#9CAF88';
		return {
			post,
			studentLabel: student?.data.displayName ?? studentSlug,
			studentUrl: getStudentUrl(studentSlug),
			accent,
		};
	}),
);
---

{
	postCards.length > 0 ? (
		<div class="post-list">
			{postCards.map(({ post, studentLabel, studentUrl, accent }) => (
				<article class="post-item" style={`--accent-color: ${accent};`}>
					<div class="post-content">
						<div class="post-meta">
							<span class="post-date">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
									<line x1="16" y1="2" x2="16" y2="6"></line>
									<line x1="8" y1="2" x2="8" y2="6"></line>
									<line x1="3" y1="10" x2="21" y2="10"></line>
								</svg>
								{formatDate(post.data.publishDate, 'long')}
							</span>
							{showStudent && studentLabel && (
								<span class="post-author">
									by <a href={studentUrl}>{studentLabel}</a>
								</span>
							)}
							{post.data.tags.length > 0 && (
								<span class="post-category">{post.data.tags[0]}</span>
							)}
						</div>
						<h3>
							<a href={getPostUrl(post)}>{post.data.title}</a>
						</h3>
						<p class="post-excerpt">{post.data.description}</p>
						<div class="post-footer">
							<span class="read-time">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<circle cx="12" cy="12" r="10"></circle>
									<polyline points="12 6 12 12 16 14"></polyline>
								</svg>
								3 min read
							</span>
							<a href={getPostUrl(post)} class="read-more-link">
								Read Article
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<line x1="5" y1="12" x2="19" y2="12"></line>
									<polyline points="12 5 19 12 12 19"></polyline>
								</svg>
							</a>
						</div>
					</div>
				</article>
			))}
		</div>
	) : (
		<div class="empty-state">
			<div class="empty-icon">🌱</div>
			<h3>Just Getting Started</h3>
			<p>{emptyMessage}</p>
		</div>
	)
}

<style>
	.post-list {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding: 0 1rem;
	}

	.post-item {
		background: var(--paper);
		border-radius: 30px 45px 35px 40px;
		padding: 2.5rem;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
		transition: all 0.4s ease;
		position: relative;
		overflow: hidden;
	}

	/* Accent bar on left using the actual student color */
	.post-item::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		width: 5px;
		height: 100%;
		background: var(--accent-color);
		transition: width 0.3s ease;
	}

	.post-item:hover {
		transform: translateX(10px);
		box-shadow: 0 15px 45px rgba(0, 0, 0, 0.1);
	}

	.post-item:hover::before {
		width: 8px;
	}

	.post-content {
		padding-left: 1rem;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
		font-size: 0.9rem;
		color: var(--text-light);
		flex-wrap: wrap;
	}

	.post-date {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.post-author a {
		color: var(--stone);
		font-weight: 500;
	}

	.post-author a:hover {
		text-decoration: underline;
	}

	.post-category {
		background: rgba(156, 175, 136, 0.2);
		padding: 0.25rem 0.75rem;
		border-radius: 20px;
		font-size: 0.8rem;
	}

	.post-item h3 {
		font-family: var(--display-font);
		font-size: 1.6rem;
		margin: 0 0 1rem 0;
		color: var(--text-dark);
	}

	.post-item h3 a {
		color: var(--text-dark);
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.post-item h3 a:hover {
		color: var(--stone);
	}

	.post-excerpt {
		color: var(--text-light);
		line-height: 1.8;
		margin: 0 0 1.5rem 0;
	}

	.post-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.read-time {
		font-size: 0.85rem;
		color: var(--text-light);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.read-more-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--stone);
		font-weight: 500;
		text-decoration: none;
		padding: 0.75rem 1.5rem;
		border-radius: 25px;
		background: rgba(122, 132, 113, 0.1);
		transition: all 0.3s ease;
	}

	.read-more-link:hover {
		background: var(--stone);
		color: white;
		gap: 0.75rem;
	}

	.empty-state {
		text-align: center;
		padding: 4rem 2rem;
		background: var(--paper);
		border-radius: 40px 35px 45px 50px;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
	}

	.empty-icon {
		font-size: 4rem;
		margin-bottom: 1.5rem;
		opacity: 0.5;
	}

	.empty-state h3 {
		font-family: var(--display-font);
		font-size: 1.8rem;
		color: var(--text-dark);
		margin: 0 0 0.5rem 0;
	}

	.empty-state p {
		color: var(--text-light);
		margin: 0;
	}

	@media (max-width: 768px) {
		.post-item {
			padding: 2rem;
		}

		.post-item:hover {
			transform: translateX(5px);
		}

		.post-content {
			padding-left: 0.5rem;
		}

		.post-item h3 {
			font-size: 1.4rem;
		}
	}
</style>
