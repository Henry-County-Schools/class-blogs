---
import { siteConfig } from '../config/site';

interface Props {
	currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="brand" href="/">
			<span class="brand-icon">🌿</span>
			<span class="brand-text">Class Blogs</span>
		</a>
		<nav class="header-nav" aria-label="Primary">
			<ul class="nav-links">
				{siteConfig.navigation.map((item) => {
					const isActive =
						item.href === '/'
							? currentPath === item.href
							: currentPath.startsWith(item.href.replace(/\/$/, ''));
					return (
						<li>
							<a class:list={[{ active: isActive }]} href={item.href}>
								{item.label}
							</a>
						</li>
					);
				})}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(250, 248, 243, 0.85);
		backdrop-filter: blur(20px);
		border-bottom: 1px solid rgba(156, 175, 136, 0.2);
	}

	.header-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.5rem 2rem;
		max-width: 1100px;
		margin: 0 auto;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--stone);
		text-decoration: none;
	}

	.brand-icon {
		font-size: 1.4rem;
	}

	.brand-text {
		font-family: var(--display-font);
		font-size: 1.8rem;
		font-weight: 600;
	}

	.header-nav {
		display: flex;
		align-items: center;
	}

	.nav-links {
		display: flex;
		gap: 2.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-links a {
		color: var(--text-light);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95rem;
		position: relative;
		padding: 0.5rem 0;
		transition: color 0.3s ease;
	}

	.nav-links a::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 0;
		height: 2px;
		background: var(--sage);
		border-radius: 2px;
		transition: width 0.3s ease;
	}

	.nav-links a:hover {
		color: var(--stone);
	}

	.nav-links a:hover::after,
	.nav-links a.active::after {
		width: 100%;
	}

	.nav-links a.active {
		color: var(--stone);
	}

	@media (max-width: 720px) {
		.header-inner {
			padding: 1rem;
		}

		.brand-text {
			font-size: 1.4rem;
		}

		.nav-links {
			gap: 1.5rem;
		}
	}
</style>
