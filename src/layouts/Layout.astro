---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';

interface Props {
	title?: string;
	description?: string;
	accent?: string;
}

const { title, description = siteConfig.description, accent = siteConfig.defaultAccent } = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? siteConfig.siteUrl);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
	</head>
	<body style={`--page-accent: ${accent};`}>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="blob-bg"></div>
		<div class="blob-bg-2"></div>
		<div class="paper-texture"></div>
		<div class="page-shell">
			<SiteHeader currentPath={Astro.url.pathname} />
			<main class="page-main" id="main-content">
				<slot />
			</main>
			<SiteFooter />
		</div>
	</body>
</html>

<style>
	:root {
		--sand: #E8DCC4;
		--sage: #9CAF88;
		--terracotta: #D4A574;
		--stone: #7A8471;
		--paper: #F5F1E8;
		--cream: #FAF8F3;
		--text-dark: #3D4035;
		--text-light: #6B7058;
		--yellow: #EDC001;
		--blue: #4A90D9;
		--purple: #8B5CF6;
		--green: #10B981;
		--cyan: #06B6D4;
		--display-font: 'Playfair Display', Georgia, serif;
		--body-font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
		--mono-font: 'Courier New', monospace;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--cream);
		color: var(--text-dark);
		font-family: var(--body-font);
		line-height: 1.7;
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		min-height: 100vh;
		overflow-x: hidden;
	}

	/* Organic Background Blobs */
	.blob-bg {
		position: fixed;
		width: 600px;
		height: 600px;
		background: linear-gradient(135deg, var(--sage) 0%, var(--sand) 50%, var(--terracotta) 100%);
		border-radius: 60% 40% 50% 50% / 50% 50% 60% 40%;
		filter: blur(80px);
		opacity: 0.15;
		z-index: -2;
		top: -200px;
		right: -200px;
		animation: float 20s ease-in-out infinite;
		pointer-events: none;
	}

	.blob-bg-2 {
		position: fixed;
		width: 500px;
		height: 500px;
		background: linear-gradient(225deg, var(--terracotta) 0%, var(--sage) 100%);
		border-radius: 40% 60% 60% 40% / 60% 40% 60% 40%;
		filter: blur(100px);
		opacity: 0.12;
		z-index: -2;
		bottom: -150px;
		left: -150px;
		animation: float 25s ease-in-out infinite reverse;
		pointer-events: none;
	}

	@keyframes float {
		0%, 100% { transform: translate(0, 0) rotate(0deg); }
		33% { transform: translate(30px, -30px) rotate(5deg); }
		66% { transform: translate(-20px, 20px) rotate(-3deg); }
	}

	/* Paper Texture Overlay */
	.paper-texture {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		opacity: 0.03;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
		pointer-events: none;
		z-index: -1;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	a:hover {
		color: var(--stone);
	}

	a:focus-visible {
		outline: 2px solid var(--sage);
		outline-offset: 3px;
	}

	img {
		display: block;
		max-width: 100%;
	}

	.page-shell {
		position: relative;
		min-height: 100vh;
	}

	.page-main {
		position: relative;
		z-index: 1;
		padding: 0 0 4rem;
	}

	.skip-link {
		position: absolute;
		left: 1rem;
		top: 1rem;
		z-index: 3;
		padding: 0.8rem 1rem;
		border-radius: 999px;
		background: var(--sage);
		color: white;
		text-decoration: none;
		transform: translateY(-180%);
		transition: transform 160ms ease;
	}

	.skip-link:focus,
	.skip-link:focus-visible {
		transform: translateY(0);
	}

	:global(.shell) {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	:global(.section-title) {
		font-family: var(--display-font);
		font-size: clamp(2.4rem, 5vw, 3.5rem);
		line-height: 1.1;
		color: var(--text-dark);
		margin: 0;
	}

	:global(.section-copy) {
		max-width: 44rem;
		margin: 0;
		color: var(--text-light);
		font-size: 1.1rem;
	}

	:global(.panel) {
		background: var(--paper);
		border-radius: 35px 50px 45px 40px;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
	}

	@media (max-width: 720px) {
		.page-main {
			padding: 0 1rem 3rem;
		}
		
		.blob-bg,
		.blob-bg-2 {
			width: 300px;
			height: 300px;
		}
	}
</style>
