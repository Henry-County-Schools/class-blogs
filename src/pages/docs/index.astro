---
import Layout from '../../layouts/Layout.astro';

const progressSteps = ['Get your slug', 'Set up your profile', 'Write your post', 'Open your PR'];

const slugRules = [
	'lowercase only',
	'letters, numbers, and hyphens only',
	'no spaces',
	'do not rename the slug after publishing unless the instructor handles the change',
];

const requiredProfileFields = ['slug', 'displayName', 'githubUsername', 'bio', 'published'];
const optionalProfileFields = ['avatar', 'accentColor', 'links'];
const optionalFrontmatter = ['updatedDate', 'tags'];

const submitChecklist = [
	'Confirm you edited only your own profile file, post files, and optional asset files.',
	'Check links, spelling, and Markdown formatting.',
	'Make sure the filename matches `YYYY-MM-DD-post-slug.md`.',
	'Set `draft: false` only when the post is ready to publish.',
	'Fill out the PR template with your slug and post title.',
];

const commonMistakes = [
	'editing another student\'s folder',
	'mismatching the slug and the profile filename',
	'using the wrong post filename pattern',
	'forgetting required frontmatter fields',
	'publishing a draft before the post is ready',
];

const frontmatterExample = `---
title: "[AI Sample] My first post"
description: "Short summary for the directory and RSS feed."
publishDate: 2026-03-09
tags:
  - example
  - intro
draft: false
---`;
---

<Layout title="Student Docs" description="Setup and writing instructions for student blogs.">
	<section class="shell docs-page">
		<header class="docs-hero" id="start-here">
			<div class="hero-content">
				<span class="hero-badge">📚 Student docs</span>
				<h1 class="docs-title">Set up your blog and publish your first post</h1>
				<p class="hero-description">
					You will use one assigned slug. You only edit files inside that slug. You publish by opening
					a pull request.
				</p>
				<p class="hero-note">Use this page for first-time setup now and quick reference later.</p>
				<div class="hero-actions">
					<a class="hero-cta" href="/students/">Browse published blogs</a>
					<a class="hero-cta subtle" href="/">Return to homepage</a>
				</div>
			</div>
			<ol class="progress-rail" aria-label="Publishing steps">
				{progressSteps.map((step, index) => (
					<li class="progress-step">
						<strong>{String(index + 1).padStart(2, '0')}</strong>
						<span>{step}</span>
					</li>
				))}
			</ol>
		</header>

		<div class="docs-layout">
			<aside class="docs-toc">
				<p class="toc-title">On this page</p>
				<nav aria-label="Docs sections">
					<a class="toc-link" href="#start-here">Start Here</a>
					<a class="toc-link" href="#quick-start">Quick Start Checklist</a>
					<a class="toc-link" href="#reference">Reference</a>
					<a class="toc-link" href="#submit">Before You Submit</a>
					<a class="toc-link" href="#help">Need More Detail?</a>
				</nav>
			</aside>

			<div class="docs-content">
				<section class="docs-section" id="quick-start">
					<div class="section-header">
						<span class="section-badge">Quick start</span>
						<h2 class="section-title">Do these steps in order</h2>
						<p class="section-description">
							This is the shortest path from getting a slug to opening your first pull request.
						</p>
					</div>
					<ol class="action-list">
						<li>
							<strong>01</strong>
							<div>
								<h3>Confirm your slug</h3>
								<p>
									Ask your instructor for your assigned <code>studentSlug</code>. You will use this
									same slug in your profile path, post folder, and public URL.
								</p>
							</div>
						</li>
						<li>
							<strong>02</strong>
							<div>
								<h3>Open your profile file</h3>
								<p>
									Edit <code>src/content/students/{'{studentSlug}'}.json</code> and keep the filename
									matched to your assigned slug.
								</p>
							</div>
						</li>
						<li>
							<strong>03</strong>
							<div>
								<h3>Update your profile fields</h3>
								<p>
									Fill in your <code>displayName</code>, <code>githubUsername</code>, <code>bio</code>,
									and publication status. Do not change <code>slug</code>.
								</p>
							</div>
						</li>
						<li>
							<strong>04</strong>
							<div>
								<h3>Add your post file</h3>
								<p>
									Create a Markdown file in <code>src/content/posts/{'{studentSlug}'}/</code>.
								</p>
							</div>
						</li>
						<li>
							<strong>05</strong>
							<div>
								<h3>Check the filename pattern</h3>
								<p>
									Name the file <code>YYYY-MM-DD-post-slug.md</code> so the generated route is stable.
								</p>
							</div>
						</li>
						<li>
							<strong>06</strong>
							<div>
								<h3>Fill in frontmatter</h3>
								<p>
									Add <code>title</code>, <code>description</code>, <code>publishDate</code>, and{' '}
									<code>draft</code>. Add optional tags or an update date if needed.
								</p>
							</div>
						</li>
						<li>
							<strong>07</strong>
							<div>
								<h3>Open your pull request</h3>
								<p>
									Submit a PR with your slug and post title. CI and instructor review are the
									publishing gate.
								</p>
							</div>
						</li>
					</ol>
				</section>

				<section class="docs-section" id="reference">
					<div class="section-header">
						<span class="section-badge">Reference</span>
						<h2 class="section-title">Look up the exact rule you need</h2>
						<p class="section-description">
							Use these sections when you need a file path, naming rule, or frontmatter reminder.
						</p>
					</div>

					<div class="reference-list">
						<section class="reference-group" id="slug-rules">
							<h3>Slug rules</h3>
							<ul>
								{slugRules.map((rule) => (
									<li>{rule}</li>
								))}
							</ul>
							<p class="inline-note">
								Generated URL pattern: <code>/students/{'{studentSlug}'}/</code> and{' '}
								<code>/students/{'{studentSlug}'}/{'{postSlug}'}/</code>
							</p>
						</section>

						<section class="reference-group" id="allowed-files">
							<h3>Files you may edit</h3>
							<ul class="path-list">
								<li><code>src/content/students/{'{studentSlug}'}.json</code></li>
								<li><code>src/content/posts/{'{studentSlug}'}/YYYY-MM-DD-post-slug.md</code></li>
								<li><code>public/student-assets/{'{studentSlug}'}/</code> if your class uses assets</li>
							</ul>
						</section>

						<section class="reference-group" id="profile-fields">
							<h3>Profile fields</h3>
							<div class="field-columns">
								<div>
									<p class="field-label">Required</p>
									<ul>
										{requiredProfileFields.map((field) => (
											<li><code>{field}</code></li>
										))}
									</ul>
								</div>
								<div>
									<p class="field-label">Optional</p>
									<ul>
										{optionalProfileFields.map((field) => (
											<li><code>{field}</code></li>
										))}
									</ul>
								</div>
							</div>
						</section>

						<section class="reference-group" id="post-filename">
							<h3>Post filename pattern</h3>
							<pre><code>src/content/posts/{'{studentSlug}'}/YYYY-MM-DD-post-slug.md</code></pre>
							<p class="inline-note">Example output URL: <code>/students/student-slug/first-post/</code></p>
						</section>

						<section class="reference-group" id="frontmatter">
							<h3>Frontmatter requirements</h3>
							<p class="field-label">Required fields</p>
							<ul class="inline-list">
								<li><code>title</code></li>
								<li><code>description</code></li>
								<li><code>publishDate</code></li>
								<li><code>draft</code></li>
							</ul>
							<p class="field-label">Optional fields</p>
							<ul class="inline-list">
								{optionalFrontmatter.map((field) => (
									<li><code>{field}</code></li>
								))}
							</ul>
							<pre><code>{frontmatterExample}</code></pre>
						</section>
					</div>
				</section>

				<section class="docs-section" id="submit">
					<div class="section-header">
						<span class="section-badge">Before you submit</span>
						<h2 class="section-title">Check these before opening your PR</h2>
					</div>
					<div class="submit-grid">
						<section class="submit-card">
							<h3>PR checklist</h3>
							<ul>
								{submitChecklist.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</section>
						<section class="submit-card">
							<h3>Common mistakes</h3>
							<ul>
								{commonMistakes.map((mistake) => (
									<li>{mistake}</li>
								))}
							</ul>
							<p class="warning-note">CI will fail if you edit files outside your assigned slug area.</p>
						</section>
					</div>
				</section>

				<section class="docs-section" id="help">
					<div class="section-header">
						<span class="section-badge">Need more detail?</span>
						<h2 class="section-title">Use these links when you need more context</h2>
					</div>
					<div class="help-links">
						<a href="/students/">Browse published student blogs</a>
						<a href="#reference">Jump back to the reference section</a>
						<p>Ask your instructor if you do not know your assigned slug yet.</p>
					</div>
				</section>
			</div>
		</div>
	</section>
</Layout>

<style>
	.docs-page {
		display: grid;
		gap: 2rem;
		padding: 2rem 0 3rem;
	}

	.docs-hero {
		background: var(--paper);
		border-radius: 35px 50px 45px 40px;
		padding: 3rem;
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
		margin-bottom: 2rem;
	}

	.hero-content {
		text-align: center;
		margin-bottom: 2rem;
	}

	.hero-badge {
		display: inline-block;
		background: linear-gradient(135deg, var(--sage), var(--sand));
		color: var(--text-dark);
		padding: 0.4rem 1rem;
		border-radius: 50px;
		font-size: 0.8rem;
		font-weight: 500;
		margin-bottom: 1rem;
	}

	.docs-title {
		font-family: var(--display-font);
		font-size: clamp(2.2rem, 3.6vw, 3.4rem);
		line-height: 1.1;
		color: var(--text-dark);
		margin: 0 0 1rem 0;
	}

	.hero-description {
		font-size: 1.2rem;
		color: var(--text-light);
		max-width: 600px;
		margin: 0 auto 0.5rem;
	}

	.hero-note {
		color: var(--text-light);
		font-size: 0.95rem;
		margin: 0 0 1.5rem 0;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.hero-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.9rem 1.8rem;
		background: var(--stone);
		color: white;
		border-radius: 30px;
		font-weight: 500;
		text-decoration: none;
		transition: all 0.3s ease;
		box-shadow: 0 4px 15px rgba(122, 132, 113, 0.3);
	}

	.hero-cta:hover {
		background: var(--sage);
		transform: translateY(-2px);
		color: white;
	}

	.hero-cta.subtle {
		background: rgba(122, 132, 113, 0.1);
		color: var(--stone);
	}

	.hero-cta.subtle:hover {
		background: rgba(122, 132, 113, 0.2);
	}

	.progress-rail {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.progress-step {
		display: grid;
		gap: 0.45rem;
		padding: 1rem;
		background: var(--cream);
		border-radius: 25px;
		border: 1px solid rgba(156, 175, 136, 0.2);
		text-align: center;
	}

	.progress-step strong {
		font-family: var(--mono-font);
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--sage);
	}

	.progress-step span {
		color: var(--text-dark);
		font-size: 0.95rem;
		line-height: 1.35;
	}

	.docs-layout {
		display: grid;
		grid-template-columns: minmax(13rem, 15rem) minmax(0, 1fr);
		gap: 2rem;
		align-items: start;
	}

	.docs-toc {
		position: sticky;
		top: 6rem;
		align-self: start;
		background: var(--paper);
		border-radius: 30px;
		padding: 1.5rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
	}

	.toc-title {
		margin: 0 0 0.85rem;
		font-family: var(--mono-font);
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-light);
	}

	.docs-toc nav {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.toc-link {
		display: block;
		padding: 0.6rem 0.9rem;
		border-radius: 15px;
		background: transparent;
		color: var(--text-light);
		text-decoration: none;
		font-size: 0.9rem;
		font-weight: 500;
		transition: all 0.2s ease;
	}

	.toc-link:hover,
	.toc-link:focus-visible {
		color: var(--stone);
		background: rgba(156, 175, 136, 0.15);
	}

	.docs-content {
		display: grid;
		gap: 2.5rem;
		min-width: 0;
	}

	.docs-section {
		display: grid;
		gap: 1.5rem;
		scroll-margin-top: 6rem;
	}

	.section-header {
		display: grid;
		gap: 0.85rem;
		padding-bottom: 1.15rem;
		border-bottom: 1px solid rgba(122, 132, 113, 0.2);
	}

	.section-badge {
		display: inline-block;
		width: fit-content;
		background: linear-gradient(135deg, var(--sage), var(--sand));
		color: var(--text-dark);
		padding: 0.3rem 0.8rem;
		border-radius: 50px;
		font-size: 0.75rem;
		font-weight: 500;
	}

	.docs-section .section-title {
		font-family: var(--display-font);
		font-size: clamp(2rem, 3.2vw, 3rem);
		color: var(--text-dark);
		margin: 0;
		line-height: 1.1;
	}

	.section-description {
		color: var(--text-light);
		margin: 0;
	}

	.action-list {
		display: grid;
		gap: 0;
		padding: 0;
		margin: 0;
		list-style: none;
		background: var(--paper);
		border-radius: 30px 45px 35px 40px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
		overflow: hidden;
	}

	.action-list li {
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: 1rem;
		padding: 1.5rem;
		border-bottom: 1px solid rgba(122, 132, 113, 0.15);
	}

	.action-list li:last-child {
		border-bottom: 0;
	}

	.action-list strong {
		font-family: var(--mono-font);
		font-size: 0.9rem;
		color: var(--sage);
	}

	.action-list h3 {
		margin: 0 0 0.35rem;
		font-family: var(--display-font);
		font-size: 1.15rem;
		color: var(--text-dark);
	}

	.action-list p {
		margin: 0;
		color: var(--text-light);
		font-size: 0.95rem;
	}

	.action-list code {
		background: rgba(156, 175, 136, 0.15);
		padding: 0.15rem 0.4rem;
		border-radius: 4px;
		font-family: var(--mono-font);
		font-size: 0.9em;
	}

	.reference-list {
		display: grid;
		gap: 1.5rem;
	}

	.reference-group {
		display: grid;
		gap: 0.8rem;
		padding: 2rem;
		background: var(--paper);
		border-radius: 30px 45px 35px 40px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
	}

	.reference-group h3 {
		margin: 0;
		font-family: var(--display-font);
		font-size: 1.5rem;
		color: var(--text-dark);
	}

	.reference-group p,
	.reference-group li {
		color: var(--text-light);
		margin: 0;
	}

	.reference-group ul {
		margin: 0;
		padding-left: 1.2rem;
	}

	.reference-group li {
		margin: 0.5rem 0;
	}

	.path-list {
		list-style: none;
		padding: 0;
	}

	.path-list li {
		padding: 0.5rem 0;
		border-bottom: 1px solid rgba(122, 132, 113, 0.15);
	}

	.path-list li:last-child {
		border-bottom: 0;
	}

	.field-columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.field-label {
		font-family: var(--mono-font);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--stone);
		margin: 0 0 0.5rem 0;
	}

	.inline-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		margin: 0 0 1rem 0;
		list-style: none;
	}

	.inline-list li {
		padding: 0.3rem 0.6rem;
		border-radius: 15px;
		background: rgba(156, 175, 136, 0.15);
		font-family: var(--mono-font);
		font-size: 0.85rem;
	}

	.inline-note {
		margin: 0.5rem 0 0 0;
		color: var(--text-light);
		font-size: 0.9rem;
	}

	pre {
		margin: 1rem 0 0 0;
		padding: 1rem;
		border-radius: 15px;
		background: var(--cream);
		border: 1px solid rgba(156, 175, 136, 0.2);
		overflow-x: auto;
	}

	pre code {
		font-family: var(--mono-font);
		font-size: 0.9em;
		background: none;
		padding: 0;
	}

	code {
		font-family: var(--mono-font);
		font-size: 0.9em;
	}

	p code,
	li code,
	.inline-note code {
		background: rgba(156, 175, 136, 0.15);
		padding: 0.15rem 0.4rem;
		border-radius: 4px;
	}

	.submit-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.submit-card {
		padding: 2rem;
		background: var(--paper);
		border-radius: 30px 45px 35px 40px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
	}

	.submit-card h3 {
		margin: 0 0 1rem 0;
		font-family: var(--display-font);
		font-size: 1.5rem;
		color: var(--text-dark);
	}

	.submit-card ul {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--text-light);
	}

	.submit-card li {
		margin: 0.5rem 0;
	}

	.warning-note {
		margin: 1rem 0 0 0;
		padding: 0.75rem 1rem;
		background: rgba(212, 165, 116, 0.15);
		border-radius: 15px;
		color: var(--terracotta);
		font-size: 0.9rem;
	}

	.help-links {
		display: grid;
		gap: 0.8rem;
		padding: 2rem;
		background: var(--paper);
		border-radius: 30px 45px 35px 40px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
	}

	.help-links a {
		width: fit-content;
		color: var(--stone);
		text-decoration: underline;
		text-decoration-thickness: 0.1em;
		text-underline-offset: 0.2em;
		font-weight: 500;
	}

	.help-links a:hover {
		color: var(--sage);
	}

	.help-links p {
		margin: 0;
		color: var(--text-light);
	}

	@media (max-width: 980px) {
		.progress-rail {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.field-columns,
		.submit-grid {
			grid-template-columns: 1fr;
		}

		.docs-layout {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.docs-toc {
			position: static;
		}

		.docs-toc nav {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 720px) {
		.docs-page {
			padding: 1.5rem 0 2rem;
		}

		.docs-hero {
			padding: 2rem;
		}

		.hero-actions,
		.docs-toc nav {
			display: grid;
			grid-template-columns: 1fr;
		}

		.progress-rail {
			grid-template-columns: 1fr;
		}

		.action-list li {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}

		.inline-list {
			display: grid;
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
