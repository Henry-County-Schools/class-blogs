---
import StudentCard from '../../components/StudentCard.astro';
import { siteConfig } from '../../config/site';
import Layout from '../../layouts/Layout.astro';
import { getPublishedStudents } from '../../lib/content';

const students = await getPublishedStudents();
---

<Layout title="Student Directory" description={`Published student blogs in ${siteConfig.title}.`}>
	<section class="shell directory-page">
		<header class="page-header">
			<h1 class="section-title">Our Learning Garden</h1>
			<p class="section-copy">
				Meet the talented students cultivating knowledge and sharing their growth with the world
			</p>
			<div class="leaf-divider">🌱 🌿 🍃</div>
		</header>
		
		<div class="students-grid">
			{students.map((student) => <StudentCard student={student} />)}
		</div>
	</section>
</Layout>

<style>
	.directory-page {
		padding: 3rem 0 6rem;
	}

	.page-header {
		text-align: center;
		padding: 3rem 2rem;
		position: relative;
	}

	.page-header h1 {
		font-family: var(--display-font);
		font-size: 3.5rem;
		color: var(--text-dark);
		margin-bottom: 1rem;
	}

	.page-header .section-copy {
		font-size: 1.2rem;
		color: var(--text-light);
		max-width: 600px;
		margin: 0 auto;
	}

	.leaf-divider {
		font-size: 2rem;
		opacity: 0.3;
		margin-top: 2rem;
		animation: floatLeaf 6s ease-in-out infinite;
	}

	@keyframes floatLeaf {
		0%, 100% { transform: translateY(0) rotate(-5deg); }
		50% { transform: translateY(-10px) rotate(5deg); }
	}

	.students-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2.5rem;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	@media (max-width: 768px) {
		.page-header h1 {
			font-size: 2.5rem;
		}

		.students-grid {
			grid-template-columns: 1fr;
			padding: 0 1rem;
		}
	}
</style>
