---
import Layout from "../layouts/Layout.astro";
import PostList from "../components/PostList.astro";
import { getPublishedStudents, getStudentAccent, getPublishedPostEntries } from "../lib/content";
import { getStudentUrl } from "../lib/content";

const students = await getPublishedStudents();
const allPosts = await getPublishedPostEntries();
const recentPosts = allPosts.slice(0, 4);

const studentData = await Promise.all(
	students.slice(0, 5).map(async (student) => ({
		student,
		accent: getStudentAccent(student),
		initials: student.data.displayName.split(' ').map(n => n[0]).join('').toUpperCase(),
	}))
);
---

<Layout description="A nurturing space for students to share their learning journey.">
	<section class="shell homepage">
		<section class="hero">
			<div class="leaf-decoration leaf-1">🌿</div>
			<div class="leaf-decoration leaf-2">🍃</div>
			<div class="hero-content">
				<div class="hero-badge">🌱 Student Learning Community</div>
				<h1>Where Ideas <span>Bloom</span> &<br>Grow Together</h1>
				<p class="hero-subtitle">A nurturing space for students to share their journey, discoveries, and passion for learning. Join our garden of knowledge.</p>
				<a href="/students/" class="hero-cta">
					Meet Our Students
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</a>
			</div>
		</section>

		<section class="recent-posts">
			<div class="section-container">
				<div class="section-header">
					<h2>Fresh from the Garden</h2>
					<p>Latest thoughts and discoveries from our learning community</p>
				</div>
				<PostList 
					items={recentPosts} 
					showStudent={true}
					emptyMessage="No posts yet. Check back soon!"
				/>
			</div>
		</section>

		<section class="students-preview">
			<div class="section-container">
				<div class="section-header">
					<h2>Our Growing Community</h2>
					<p>Meet the students sharing their learning journey</p>
				</div>
				<div class="students-grid">
					{studentData.map(({ student, accent, initials }) => (
						<a href={getStudentUrl(student.data.slug)} class="student-mini">
							<div class="avatar" style={`background: linear-gradient(135deg, ${accent}, ${accent}dd);`}>{initials}</div>
							<h4>{student.data.displayName.split(' ')[0]}</h4>
							<p>"{student.data.bio.slice(0, 40)}{student.data.bio.length > 40 ? '...' : ''}"</p>
						</a>
					))}
				</div>
			</div>
		</section>
	</section>
</Layout>

<style>
	.homepage {
		padding: 1rem 0 1rem;
	}

	/* Hero Section */
	.hero {
		min-height: 80vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 4rem 2rem;
		position: relative;
	}

	.hero-content {
		max-width: 800px;
		text-align: center;
		position: relative;
		z-index: 1;
	}

	.hero-badge {
		display: inline-block;
		background: linear-gradient(135deg, var(--sage), var(--sand));
		color: var(--text-dark);
		padding: 0.6rem 1.5rem;
		border-radius: 50px;
		font-size: 0.85rem;
		font-weight: 500;
		margin-bottom: 2rem;
		box-shadow: 0 4px 15px rgba(156, 175, 136, 0.3);
	}

	.hero h1 {
		font-family: var(--display-font);
		font-size: 4.5rem;
		font-weight: 400;
		line-height: 1.1;
		margin-bottom: 1.5rem;
		color: var(--text-dark);
	}

	.hero h1 span {
		font-style: italic;
		color: var(--terracotta);
	}

	.hero-subtitle {
		font-size: 1.25rem;
		color: var(--text-light);
		max-width: 600px;
		margin: 0 auto 3rem;
		font-weight: 300;
	}

	.hero-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		background: var(--stone);
		color: white;
		padding: 1.2rem 2.5rem;
		border-radius: 50px;
		text-decoration: none;
		font-weight: 500;
		font-size: 1.1rem;
		box-shadow: 0 8px 30px rgba(122, 132, 113, 0.3);
		transition: all 0.3s ease;
	}

	.hero-cta:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 40px rgba(122, 132, 113, 0.4);
		color: white;
	}

	/* Decorative Leaves */
	.leaf-decoration {
		position: absolute;
		font-size: 8rem;
		opacity: 0.08;
		animation: sway 8s ease-in-out infinite;
		pointer-events: none;
	}

	.leaf-1 {
		top: 15%;
		left: 5%;
		transform: rotate(-30deg);
	}

	.leaf-2 {
		bottom: 20%;
		right: 8%;
		transform: rotate(30deg);
		animation-delay: -4s;
	}

	@keyframes sway {
		0%, 100% { transform: rotate(-30deg) translateY(0); }
		50% { transform: rotate(-25deg) translateY(-10px); }
	}

	/* Recent Posts Section */
	.recent-posts {
		padding: 6rem 2rem;
		background: linear-gradient(180deg, transparent 0%, rgba(156, 175, 136, 0.05) 50%, transparent 100%);
	}

	.section-container {
		max-width: 1100px;
		margin: 0 auto;
	}

	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.section-header h2 {
		font-family: var(--display-font);
		font-size: 2.8rem;
		color: var(--text-dark);
		margin-bottom: 1rem;
	}

	.section-header p {
		color: var(--text-light);
		font-size: 1.1rem;
	}

	/* Students Preview Section */
	.students-preview {
		padding: 6rem 2rem;
	}

	.students-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 2rem;
		margin-top: 3rem;
	}

	.student-mini {
		text-align: center;
		padding: 2rem;
		background: var(--paper);
		border-radius: 40px 30px 50px 35px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
		transition: all 0.3s ease;
		text-decoration: none;
		color: inherit;
	}

	.student-mini:hover {
		transform: translateY(-5px) scale(1.02);
		box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
		color: inherit;
	}

	.student-mini .avatar {
		width: 70px;
		height: 70px;
		border-radius: 50%;
		margin: 0 auto 1rem;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 600;
		color: white;
		font-size: 1.2rem;
	}

	.student-mini h4 {
		font-family: var(--display-font);
		font-size: 1.2rem;
		margin-bottom: 0.5rem;
		color: var(--text-dark);
	}

	.student-mini p {
		font-size: 0.85rem;
		color: var(--text-light);
		line-height: 1.5;
		margin: 0;
	}

	@media (max-width: 768px) {
		.hero h1 {
			font-size: 2.8rem;
		}

		.hero-subtitle {
			font-size: 1.1rem;
		}

		.section-header h2 {
			font-size: 2.2rem;
		}

		.leaf-decoration {
			font-size: 4rem;
		}

		.students-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.students-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
